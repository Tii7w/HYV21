# HKY Estates V2 - ortam değişkenleri
# 'python backend/scripts/init_env.py' bu dosyadan .env üretir. .env dosyasını asla paylaşmayın veya commit etmeyin.

# Varsayılan: backend/data/hky.db (SQLite). PostgreSQL için örnek:
# DATABASE_URL=postgresql+psycopg://hky:sifre@localhost:5432/hky
DATABASE_URL=

# Oturum imzası ve API anahtarı/proxy şifresi şifrelemesi için en az 32 karakter
HKY_SECRET_KEY=

# İlk çalıştırmada oluşturulacak yönetici hesabı
ADMIN_EMAIL=admin@hky.local
ADMIN_PASSWORD=

# HTTPS arkasında çalışırken true yapın
COOKIE_SECURE=false
SESSION_HOURS=24

# Resmi Sahibinden API erişimi (sözleşme ve dokümantasyon olmadan kullanılmaz)
SAHIBINDEN_API_BASE_URL=
SAHIBINDEN_API_KEY=
